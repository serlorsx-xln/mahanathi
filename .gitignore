# macOS and exFAT side files
.DS_Store
._*

# dependencies and builds
node_modules/
dist/
# server/web/dist holds the copied web build for go:embed. Only the
# .gitkeep is tracked, so a fresh clone still compiles.
!server/web/dist/
server/web/dist/*
!server/web/dist/.gitkeep
server/bin/
coverage/
*.tsbuildinfo
.eslintcache

# test output
test-results/
playwright-report/
blob-report/

# runtime data
/data/
*.db
*.db-wal
*.db-shm

# download caches (DEM tiles, fonts, raw API responses); large and reproducible
.cache/
geodata/.cache/

# agent orchestration (local only)
process/logs/
process/.session-id

# env
.env
.env.*
!.env.example

# Python bytecode from the research scripts
__pycache__/
*.pyc
# The retry harness's working prompts (canonical prompts live in process/prompts/)
process/.phase-prompt*
process/.retry-prompt*
